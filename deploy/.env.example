# ============================================================
# 赛博技术秀场网站 · 统一配置中心（唯一配置入口）
# ============================================================
# 使用方法：
#   1. cp .env.example .env
#   2. 按需修改本文件中的值
#   3. docker compose 启动时会自动读取同目录 .env，无需其他配置
# 说明：
#   - 生产环境用 deploy.sh 一键部署时，数据库密码会自动随机生成并覆盖本文件
#   - 修改本文件后执行 `docker compose up -d` 即可生效
# ============================================================

# ---------- 网站访问 ----------
# 对外 HTTP 端口（阿里云安全组需与此端口一致；改端口后记得同步安全组）
HTTP_PORT=80

# ---------- 数据库账号 ----------
# 数据库名 / 应用账号（后端与备份脚本共用，勿单独改某一处）
MYSQL_DB=cyber_show
MYSQL_USER=cyber
# root 密码与应用账号密码（生产环境务必修改；本地开发默认值仅用于本机）
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_PASSWORD=change_me_app

# ---------- MySQL 性能调优 ----------
# 当前值已适配 2核1.6G 低配服务器；升配后可调大 BUFFER_POOL（约为内存一半）
MYSQL_BUFFER_POOL=128M
MYSQL_MAX_CONNECTIONS=50
# OFF 可省约 100MB 内存；若需性能分析工具则改为 ON
MYSQL_PERFORMANCE_SCHEMA=OFF

# ---------- 后端 JVM 内存 ----------
# 1.6G 机器实测 -Xmx384m 稳定；内存紧张时勿调大
JAVA_OPTS=-Xms128m -Xmx384m

# ---------- 时区 ----------
TZ=Asia/Shanghai
