# DeepSeek Harness 模型凭据
#
# 说明：
#   本文件由 systemd 的 dsh.service 通过 EnvironmentFile 注入，
#   DSH 启动时继承这里的环境变量，重启不丢失。
#   文件权限 600，属主 dsh，不会被提交到 Git 仓库。
#
# 用法：
#   1. 复制一行，去掉注释符号，把等号右边换成你自己的 Key
#   2. 保存后重启 DSH 生效（可在工作台「DeepSeek Harness」页点停止再启动）
#   3. 改完可在本文件里保留多个 provider，DSH 会按配置选用
#
# 注意：
#   - 等号两边不要加空格
#   - 值不要用引号包裹
#   - 不需要的行保持注释状态即可

# ---------- DeepSeek 官方 ----------
# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx

# ---------- 通义千问 / 阿里云百炼 Token Plan ----------
# 国际版（新加坡等）
# QWEN_TOKEN_PLAN_API_KEY=sk-xxxxxxxxxxxxxxxx
# 国内版（阿里云百炼 Coding Plan）
# QWEN_TOKEN_PLAN_CN_API_KEY=sk-xxxxxxxxxxxxxxxx

# ---------- OpenAI / 兼容接口 ----------
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
# OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxx

# ---------- 其他常见 provider ----------
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=
# MISTRAL_API_KEY=
# MOONSHOT_API_KEY=
# KIMI_API_KEY=
# MINIMAX_API_KEY=
# MINIMAX_CN_API_KEY=
# TOGETHER_API_KEY=
# FIREWORKS_API_KEY=
# CEREBRAS_API_KEY=
# XAI_API_KEY=
# NVIDIA_API_KEY=
# CLOUDFLARE_API_KEY=
# AZURE_OPENAI_API_KEY=
