# 复制为 .env 后按需修改；.env 不入库
PORT=3001
DB_PATH=/opt/workbench/data/workbench.db

# 会话有效期（秒），默认 7 天
SESSION_TTL=604800

# 启用 HTTPS 后改为 true，Cookie 才会带 Secure 标记
SECURE_COOKIE=false
TRUST_PROXY=true

# 登录防爆破
MAX_FAILED_LOGIN=5
LOCK_SECONDS=900

# DSH 相关
DSH_SERVICE=dsh
DSH_LOG=/home/dsh/dsh.log
DSH_PORT=3080
PUBLIC_DSH_PATH=/dsh/
