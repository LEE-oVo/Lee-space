# 复制为 .env 后按需修改；.env 不入库
PORT=3001
DB_PATH=/opt/workbench/data/workbench.db

# 会话有效期（秒），默认 7 天
SESSION_TTL=604800

# 启用 HTTPS 后改为 true，Cookie 才会带 Secure 标记
SECURE_COOKIE=false
TRUST_PROXY=true

# 登录防爆破
MAX_FAILED_LOGIN=5
LOCK_SECONDS=900

# DSH 相关
DSH_SERVICE=dsh
DSH_LOG=/home/dsh/dsh.log
DSH_PORT=3080
PUBLIC_DSH_PATH=/dsh/

# 游客免登录（登录页出现「以游客身份进入」按钮）
GUEST_ENABLED=true
GUEST_USERNAME=guest
# 游客会话有效期（秒），默认 12 小时，远短于正式登录
GUEST_SESSION_TTL=43200
# 同一 IP 在窗口期内最多可领取的游客会话数
GUEST_RATE_LIMIT=30
GUEST_RATE_WINDOW=300

# 首页天气默认城市（数据来自 Open-Meteo，无需 Key）
WEATHER_CITY=深圳
WEATHER_LAT=22.54554
WEATHER_LON=114.0683

# 基金建议写入令牌：定时任务用它写建议、读持仓（POST /wb-api/funds/ingest）
# 格式「来源:令牌」逗号分隔，**来源由用哪个令牌唯一决定**，任务自报 source 一律忽略。
# 接入新模型 = 在这里多加一项，代码不用改。
# 生成/轮换：node src/scripts/rotate-fund-token.js <来源名>
# 全部留空则写入接口直接关闭（返回 503）
FUND_INGEST_TOKENS=
# 允许写账本（/settle，会真改份额与成本）的来源，逗号分隔；留空 = 不限制。
# 例如只想让主工具和 Trae 结算、新模型只出建议：FUND_SETTLE_SOURCES=workbuddy,trae
FUND_SETTLE_SOURCES=
# 来源展示名（页面上怎么称呼它）。内置 workbuddy/trae/glm/manual，其他在这里补
FUND_SOURCE_LABELS=
