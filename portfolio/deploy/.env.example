# =====================================================
# 个人作品网站 —— 唯一配置入口（复制为 .env 后按需修改）
# cp .env.example .env
# compose 中所有参数均以 ${VAR:-默认值} 引用本文件
# =====================================================

# ---------- 站点 ----------
# 对外 HTTP 端口（替换原赛博站点，保持 80）
HTTP_PORT=80
TZ=Asia/Shanghai

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=CHANGE_ME_root_password
MYSQL_DB=portfolio_db
MYSQL_USER=lee
MYSQL_PASSWORD=CHANGE_ME_user_password
# 小内存机器调优
MYSQL_BUFFER_POOL=128M
MYSQL_MAX_CONNECTIONS=50
MYSQL_PERFORMANCE_SCHEMA=OFF

# ---------- 后端 ----------
JAVA_OPTS=-Xms128m -Xmx384m
# JWT 签名密钥（生产环境务必修改为随机长字符串）
JWT_SECRET=CHANGE_ME_jwt_secret_at_least_32_chars
# token 有效期（毫秒，默认 24 小时）
JWT_EXPIRE=86400000
